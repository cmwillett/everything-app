rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }

    // Everything private: each person reads and writes only their own space.
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Connection requests ("Craig wants to share with you").
    match /invites/{id} {
      allow read: if signedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toEmail == myEmail() ||
        resource.data.get('toUid', '') == request.auth.uid);
      // Only as yourself, only as a new pending request.
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.toEmail == request.resource.data.toEmail.lower()
        && request.resource.data.toEmail != myEmail();
      // Only the person it's addressed to answers it, and only these fields.
      allow update: if signedIn()
        && resource.data.toEmail == myEmail()
        && request.resource.data.toUid == request.auth.uid
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'toUid', 'toName', 'respondedAt']);
      // Either side can cancel / disconnect.
      allow delete: if signedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toEmail == myEmail() ||
        resource.data.get('toUid', '') == request.auth.uid);
    }

    // Shared tasks, reminders, notes and lists.
    match /shared/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // You create it as its owner, and you're in it.
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.auth.uid in request.resource.data.members;
      // Members can edit. Only the owner changes who it's shared with;
      // anyone else may only take themselves off it ("leave").
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.owner == resource.data.owner
        && (
          (request.auth.uid == resource.data.owner && request.auth.uid in request.resource.data.members) ||
          request.resource.data.members == resource.data.members ||
          request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
        );
      // Only the owner deletes it.
      allow delete: if signedIn() && request.auth.uid == resource.data.owner;
    }
  }
}
